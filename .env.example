# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# Placeholder values only — no real secrets in this file.

# --- Model provider (REQUIRED) ---
# Get your key: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# --- LangSmith (OPTIONAL: tracing + eval datasets) ---
# The lab runs offline without this. Set it to trace runs, seed eval datasets (notebook 02),
# and follow the observability notebook (05). Get your key: https://smith.langchain.com/settings
# LANGSMITH_API_KEY="lsv2_..."
# LANGSMITH_TRACING="true"
# LANGSMITH_PROJECT="medical-information-qa"
# LANGSMITH_WORKSPACE_ID=""   # optional: scopes LangSmith UI links to your workspace

# --- Optional: override the default model (else it comes from utils/models.py) ---
# LABS_MODEL="openai:gpt-4o-mini"

# --- Optional: opt in to LIVE online-eval run rules in notebook 05 (mutates your LangSmith workspace) ---
# ENABLE_ONLINE_EVALS="1"
