# Northfield Health chart Q&A workshop (synthetic data). Copy to .env and fill in.
# Never commit .env.

# --- Required: who you are (scopes every LangSmith resource you create) ------
WORKSHOP_USER="<first-last>"

# --- Required: LangSmith ------------------------------------------------------
LANGSMITH_API_KEY=""
LANGSMITH_TRACING="true"
LANGSMITH_PROJECT="chart-qa-${WORKSHOP_USER}"
# Optional: pin to a workspace if your key can see several
# LANGSMITH_WORKSPACE_ID=""
# Optional: self-hosted LangSmith
# LANGSMITH_ENDPOINT="https://api.smith.langchain.com"

# --- Models (provider:model) --------------------------------------------------
# Generation, embeddings and the LLM judge are switched independently.
LABS_MODEL="openai:gpt-5.4-mini"
LABS_EMBEDDINGS="openai:text-embedding-3-small"
LABS_JUDGE_MODEL="openai:gpt-5.4-mini"

# openai:* models go through the LangSmith gateway by default, authenticated with
# LANGSMITH_API_KEY (no OpenAI key needed). To call OpenAI directly instead:
#   LABS_OPENAI_BASE_URL=""
#   OPENAI_API_KEY="sk-..."
# LABS_OPENAI_BASE_URL="https://gateway.smith.langchain.com/openai/v1"

# --- Local models via Ollama (optional) -------------------------------------
# brew install ollama && ollama serve
# ollama pull qwen2.5:7b && ollama pull nomic-embed-text
# LABS_MODEL="ollama:qwen2.5:7b"
# LABS_EMBEDDINGS="ollama:nomic-embed-text"
# OLLAMA_BASE_URL="http://localhost:11434"

# --- Optional -----------------------------------------------------------------
# Notebook 05 only: actually create online-eval run rules (mutates your workspace)
# ENABLE_ONLINE_EVALS="1"
# REVIEW_QUEUE_ID=""
